# 球馆预约管理系统 - 环境变量配置
# 开发环境配置

# ============================================
# 数据库配置
# ============================================
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=gym_booking
MYSQL_USER=gym_user
MYSQL_PASSWORD=gym_password_2024

# ============================================
# JWT 配置
# ============================================
# 注意：JWT 密钥至少 32 个字符
JWT_SECRET=gym_booking_jwt_secret_key_2024_for_development_use_only

# ============================================
# Docker 配置
# ============================================
# Docker Hub 用户名（用于生产环境）
DOCKER_REGISTRY=gym-booking

# 版本标签
VERSION=latest

# ============================================
# 端口配置
# ============================================
# 容器内部端口
BACKEND_PORT=8080
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443
MYSQL_PORT=3306

# 宿主机映射端口
MYSQL_HOST_PORT=13306
BACKEND_HOST_PORT=18081
FRONTEND_HOST_PORT=18080

# ============================================
# 应用配置
# ============================================
# 环境：dev / test / prod
SPRING_PROFILES_ACTIVE=dev

# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
