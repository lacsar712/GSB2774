# 球馆预约管理系统 - 环境变量配置
# 复制此文件为 .env 并修改相应的值

# ============================================
# 数据库配置
# ============================================
MYSQL_ROOT_PASSWORD=your_secure_root_password_here
MYSQL_DATABASE=gym_booking
MYSQL_USER=gym_user
MYSQL_PASSWORD=your_secure_db_password_here

# ============================================
# JWT 配置
# ============================================
# 注意：JWT 密钥至少 32 个字符
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_please_change_this

# ============================================
# Docker 配置
# ============================================
# Docker Hub 用户名（用于生产环境）
DOCKER_REGISTRY=your-dockerhub-username

# 版本标签
VERSION=latest

# ============================================
# 端口配置
# ============================================
# 容器内部端口
BACKEND_PORT=8080
FRONTEND_PORT=80
FRONTEND_HTTPS_PORT=443
MYSQL_PORT=3306

# 宿主机映射端口
MYSQL_HOST_PORT=13306
BACKEND_HOST_PORT=18081
FRONTEND_HOST_PORT=18080

# ============================================
# 应用配置
# ============================================
# 环境：dev / test / prod
SPRING_PROFILES_ACTIVE=prod

# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
