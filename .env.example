# 球馆预约管理系统 - 环境变量配置
# 复制此文件为 .env 并按需修改相应的值
# 默认值已与 docker-compose.yml 对齐，开箱即用：执行 docker compose up --build 即可一键启动

# ============================================
# 数据库配置
# ============================================
# MySQL root 用户密码（生产环境务必修改）
MYSQL_ROOT_PASSWORD=root
# 数据库名
MYSQL_DATABASE=gym_booking

# 后端连接数据库使用的用户名/密码（默认使用 root）
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# ============================================
# 端口配置
# ============================================
# MySQL 容器内部端口
MYSQL_CONTAINER_PORT=3306
# MySQL 映射到宿主机的端口
MYSQL_HOST_PORT=13306

# 后端容器内部端口
BACKEND_CONTAINER_PORT=8080
# 后端映射到宿主机的端口
BACKEND_HOST_PORT=18081

# 前端容器内部端口
FRONTEND_CONTAINER_PORT=80
# 前端映射到宿主机的端口
FRONTEND_HOST_PORT=18080

# ============================================
# 时区配置
# ============================================
TZ=Asia/Shanghai

# ============================================
# JWT 配置
# ============================================
# 注意：JWT 密钥至少 32 个字符
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long_please_change_this

# ============================================
# Docker 配置
# ============================================
# Docker Hub 用户名（用于生产环境）
DOCKER_REGISTRY=your-dockerhub-username
# 版本标签
VERSION=latest

# ============================================
# 应用配置
# ============================================
# 环境：dev / test / prod
SPRING_PROFILES_ACTIVE=prod
# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO
